{
  "name": "rogerai-web",
  "version": "0.0.0",
  "private": true,
  "description": "RogerAI site: a SvelteKit app (app/) prerendered to one static tree in dist/ by node build.mjs",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-concurrency=1 test/*.mjs && vitest run",
    "test:guards": "node --test --test-concurrency=1 test/*.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test -c playwright.config.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs"
  },
  "imports": {
    "#lib/*": "./app/lib/*"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "entities": "^8.1.0",
    "jsdom": "30.1.3",
    "mdsvex": "0.12.8",
    "svelte": "5.57.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "type": "module"
}
