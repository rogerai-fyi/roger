#!/usr/bin/env bash
# tools/edgesim - simulated Raspberry Pis on their own network, joined to a simulated authority the
# same way a real Pi joins: allow its key on the authority, then enroll. Rootless podman.
#
#   edgesim up [N]        build, start a hub and N Pis (default 3), enroll each
#   edgesim status        the hub's view of its Edge (roger edge)
#   edgesim fleet         the hub's live fleet window (q quits)
#   edgesim reboot <pi>   restart a Pi's container (a power cycle)
#   edgesim cut <pi>      take a Pi off the network;  edgesim heal <pi> puts it back
#   edgesim sh <name>     a shell on the hub or a Pi
#   edgesim roger <name> <args...>   run roger there
#   edgesim seed <pi> [<models dir>]   copy the CPU llama.cpp runtime and models into a Pi,
#                         for when the simulated network has no internet
#   edgesim down          stop and remove everything (volumes too)
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"
NET=edgesim
IMAGE=localhost/edgesim:latest
HUB=edgesim-hub
MODEL="${EDGESIM_MODEL:-Raspberry Pi 5 Model B Rev 1.0}"

say() { printf 'edgesim: %s\n' "$*"; }

build() {
	say "building roger and the simulated-Pi image"
	(cd "$REPO" && CGO_ENABLED=0 GOTMPDIR="${GOTMPDIR:-$HOME/.cache/gotmp}" TMPDIR="${TMPDIR:-$HOME/.cache/gotmp}" \
		go build -ldflags "-X main.Version=$(cd "$REPO" && git describe --always --dirty)-edgesim" -o "$HERE/roger" ./cmd/rogerai)
	podman build -q -t "$IMAGE" "$HERE" >/dev/null
	rm -f "$HERE/roger"
}

run_node() { # name role model
	# A Pi 5's resources (EDGESIM_MEMORY / EDGESIM_CPUS), and none of the host's GPUs: a simulated
	# Pi must not see the cards of the machine it runs on.
	podman run -d --name "edgesim-$1" --hostname "$1" --network "$NET" \
		--memory "${EDGESIM_MEMORY:-8g}" --cpus "${EDGESIM_CPUS:-4}" \
		--security-opt mask=/sys/class/drm \
		-v "edgesim-$1:/root/.config" \
		-e ROGERAI_EDGE_MACHINE="$3" -e EDGESIM_NAME="$1" \
		-e ROGERAI_EDGE_BIND=:44100 -e ROGERAI_EDGE_AUTHORITY_BIND=:39009 \
		"$IMAGE" "$2" >/dev/null
}

r() { local n="$1"; shift; podman exec "edgesim-$n" roger "$@"; }

up() {
	local n="${1:-3}"
	build
	if ! podman network exists "$NET"; then
		# The network's own DNS answers container names (edgesim-hub); its upstream for everything
		# else is the host's own resolver, so a simulated Pi can reach the internet the way the host does.
		local dns=()
		for ns in $(awk '$1 == "nameserver" && $2 !~ /^127\./ && $2 !~ /:/ {print $2}' /etc/resolv.conf); do dns+=(--dns "$ns"); done
		podman network create "${dns[@]}" "$NET" >/dev/null
	fi
	if ! podman container exists "$HUB"; then
		say "starting the hub (the authority)"
		run_node hub hub "$MODEL"
	fi
	for _ in $(seq 1 30); do r hub edge >/dev/null 2>&1 && break; sleep 1; done
	for i in $(seq 1 "$n"); do
		local pi="pi-$i"
		if podman container exists "edgesim-$pi"; then say "$pi is already up"; continue; fi
		say "starting $pi"
		run_node "$pi" member "$MODEL"
		local key
		key="$(podman exec "edgesim-$pi" roger edge setup </dev/null 2>/dev/null | awk '/authority allow/ {print $NF}')"
		r hub edge authority allow "$key" >/dev/null
		r "$pi" edge enroll "$pi" --authority http://edgesim-hub:39009 | grep -v 'update available' || true
	done
	say "up. watch it with: $0 status   (or: $0 fleet)"
}

case "${1:-}" in
up) shift; up "$@" ;;
status) r hub edge 2>&1 | grep -v 'update available' ;;
fleet) podman exec -it "$HUB" roger edge fleet ;;
reboot) podman restart "edgesim-$2" >/dev/null && say "$2 restarted" ;;
cut) podman network disconnect "$NET" "edgesim-$2" && say "$2 is off the network" ;;
heal) podman network connect "$NET" "edgesim-$2" && say "$2 is back on the network" ;;
sh) podman exec -it "edgesim-$2" bash ;;
roger) n="$2"; shift 2; r "$n" "$@" ;;
seed)
	pi="$2"; LOCAL="${EDGESIM_SEED_FROM:-$HOME/.cache/gotmp/modeltry/rogerai/local}"
	models="${3:-$LOCAL/models}"
	# Only the CPU build: a simulated Pi has no GPU, and the CUDA build is a gigabyte.
	cpu="$(ls -d "$LOCAL"/runtime/*/ubuntu-x64 2>/dev/null | head -1)"
	[ -n "$cpu" ] || { say "no CPU runtime under $LOCAL/runtime - serve a model there once to fetch it"; exit 1; }
	tag="$(basename "$(dirname "$cpu")")"
	podman exec "edgesim-$pi" mkdir -p "/root/.config/rogerai/local/runtime/$tag"
	podman cp "$cpu" "edgesim-$pi:/root/.config/rogerai/local/runtime/$tag/ubuntu-x64"
	podman cp "$models" "edgesim-$pi:/root/.config/rogerai/local/models"
	say "$pi has the runtime and models from $LOCAL"
	;;
down)
	for c in $(podman ps -a --format '{{.Names}}' | grep '^edgesim-' || true); do podman rm -f "$c" >/dev/null; done
	for v in $(podman volume ls --format '{{.Name}}' | grep '^edgesim-' || true); do podman volume rm -f "$v" >/dev/null; done
	podman network exists "$NET" && podman network rm "$NET" >/dev/null || true
	say "down"
	;;
*) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
